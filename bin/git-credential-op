#!/bin/sh
# git credential helper that resolves GH_TOKEN from 1Password and returns it
# to git. Lets plain system `git` clone/fetch/push to GitHub authenticate with
# no op-run.sh prefix and no git wrapper, so local git ops (status, commit,
# log) stay fast and independent of 1Password.
#
# Wired up by session-init.sh:
#   git config --global credential.https://github.com.helper '!<path>/git-credential-op'
#
# git invokes it as `git-credential-op <get|store|erase>`. Only `get` is
# handled; store/erase are no-ops.
#
# NOTE: this resolves the token with `op run --no-masking`. op run's default
# masking rewrites any secret on its stdout to "<concealed by 1Password>",
# which would hand git a bogus 24-char password. Masking is safe to disable
# here because this output is consumed by git's credential machinery over a
# pipe, never printed to a terminal or transcript. The token is captured into
# a shell variable and never written to disk.
[ "$1" = "get" ] || exit 0
cat >/dev/null 2>&1   # drain git's request on stdin (we always return the same token)

M="$(cd "$(dirname "$0")/.." && pwd)"
OP_SERVICE_ACCOUNT_TOKEN="$(tr -d '\n' < "$M/.credentials/op_token")" || exit 1
export OP_SERVICE_ACCOUNT_TOKEN
tok="$("$M/bin/op" run --no-masking --env-file="$M/.op-env" -- sh -c 'printf %s "$GH_TOKEN"')" || exit 1
[ -n "$tok" ] || exit 1
printf 'username=x-access-token\npassword=%s\n' "$tok"
